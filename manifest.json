{
  "manifest_version": 3,
  "name": "Simple LLM Form Filler",
  "version": "1.3",
  "browser_specific_settings": {
    "gecko": {
      "id": "simple-llm-form-filler@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "menus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}